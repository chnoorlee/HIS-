HIS_ENV=development
HIS_DATABASE_URL=sqlite:///./data/his.db
HIS_DATA_DIR=./data
HIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
HIS_RUN_WORKER=true
HIS_MODEL_PROVIDER=demo
HIS_ASR_PROVIDER=unavailable
HIS_EMR_PROVIDER=mock
